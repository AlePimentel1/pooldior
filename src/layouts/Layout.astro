---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { company } from "../data/site";

interface Props {
  title: string;
  description?: string;
  forceDarkHeader?: boolean;
}

const {
  title,
  description = `${company.name} — Fabricación, colocación, mantenimiento y servicio técnico de piscinas de fibra de vidrio en Uruguay desde ${company.since}.`,
  forceDarkHeader = false,
} = Astro.props;

const pageTitle = title === company.name ? title : `${title} · ${company.name}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Work+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-sand-50 text-ink antialiased">
    <Header forceDark={forceDarkHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
