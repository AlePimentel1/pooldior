---
import { company, contact, warranty, services, navItems, waLink, waMessages } from "../data/site";

const year = new Date().getFullYear();

const serviceLinks = services.map((s) => ({
  label: s.title,
  href: `/servicios#${s.id}`,
}));
---

<footer class="bg-navy-900 text-pool-100">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div class="max-w-sm">
      <div class="flex items-center gap-2.5">
        <span class="h-6 w-6 flex-none rounded-full rounded-bl-sm bg-pool-500"></span>
        <span class="font-display text-xl text-white">Pool<span class="text-pool-500">Dior</span></span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-pool-100/70">
        Fabricación de piscinas de fibra de vidrio en Uruguay desde {company.since}. Colocación,
        mantenimiento y servicio técnico propio, con {warranty.structureYears} años de garantía en
        la estructura.
      </p>
    </div>

    <div>
      <h2 class="eyebrow text-pool-100/50">Servicios</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {
          serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-pool-100/80 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-pool-100/50">Sitio</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {
          navItems.map((link) => (
            <li>
              <a href={link.href} class="text-pool-100/80 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-pool-100/50">Contacto</h2>
      <ul class="mt-4 space-y-3 text-sm text-pool-100/80">
        <li>
          <a href={contact.phoneHref} class="tnum transition-colors hover:text-white">
            {contact.phone}
          </a>
        </li>
        <li>
          <a
            href={waLink(waMessages.general)}
            target="_blank"
            rel="noopener noreferrer"
            class="tnum transition-colors hover:text-white"
          >
            WhatsApp {contact.whatsapp}
          </a>
        </li>
        {
          contact.hours.map((h) => (
            <li class="tnum text-pool-100/60">
              {h.days} {h.time}
            </li>
          ))
        }
        <li class="text-pool-100/60">{company.coverage}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-pool-100/10">
    <div
      class="container-page flex flex-col gap-2 py-6 text-xs text-pool-100/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {company.name}. Todos los derechos reservados.</p>
      <p>Piscinas de fibra de vidrio · Uruguay</p>
    </div>
  </div>
</footer>
