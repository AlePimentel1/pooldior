---
const year = new Date().getFullYear();

const serviceLinks = [
  { label: "Fabricación", href: "/servicios#fabricacion" },
  { label: "Colocación", href: "/servicios#colocacion" },
  { label: "Mantenimiento", href: "/servicios#mantenimiento" },
  { label: "Servicio técnico", href: "/servicios#servicio" },
];

const siteLinks = [
  { label: "Nosotros", href: "/nosotros" },
  { label: "Modelos", href: "/modelos" },
  { label: "Contacto", href: "/contacto" },
];
---

<footer class="bg-pool-950 text-sand-100">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div class="max-w-sm">
      <span class="font-display text-2xl tracking-[0.15em] text-sand-50">POOLDIOR</span>
      <p class="mt-4 text-sm leading-relaxed text-sand-100/70">
        Fabricación de piscinas de fibra de vidrio en Uruguay desde 2014. Fabricación,
        colocación, mantenimiento y servicio técnico, con hasta 15 años de garantía en
        estructura.
      </p>
    </div>

    <div>
      <h3 class="text-xs uppercase tracking-[0.15em] text-sand-100/50">Servicios</h3>
      <ul class="mt-4 space-y-3 text-sm">
        {
          serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sand-100/80 transition-colors hover:text-sand-50">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs uppercase tracking-[0.15em] text-sand-100/50">Sitio</h3>
      <ul class="mt-4 space-y-3 text-sm">
        {
          siteLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sand-100/80 transition-colors hover:text-sand-50">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs uppercase tracking-[0.15em] text-sand-100/50">Contacto</h3>
      <ul class="mt-4 space-y-3 text-sm text-sand-100/80">
        <li>
          <a href="tel:+59800000000" class="transition-colors hover:text-sand-50">
            +598 00 000 000
          </a>
        </li>
        <li>
          <a href="mailto:hola@pooldior.com.uy" class="transition-colors hover:text-sand-50">
            hola@pooldior.com.uy
          </a>
        </li>
        <li>Montevideo, Uruguay</li>
      </ul>
      <div class="mt-5 flex gap-4">
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-sand-100/70 transition-colors hover:text-sand-50"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="https://wa.me/59800000000"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="text-sand-100/70 transition-colors hover:text-sand-50"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 20.5l1.4-4.1a8 8 0 1 1 3.1 3.1z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-sand-100/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-sand-100/50 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Pooldior. Todos los derechos reservados.</p>
      <p>Sitio diseñado y desarrollado a medida.</p>
    </div>
  </div>
</footer>
