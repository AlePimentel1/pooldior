---
import Icon from "./Icon.astro";
import type { Review } from "../data/site";

interface Props {
  review: Review;
  /** La primera reseña se muestra destacada, como cita editorial. */
  featured?: boolean;
}

const { review, featured = false } = Astro.props;
---

<figure
  class:list={[
    "flex h-full flex-col rounded-card border border-pool-200 bg-white p-6",
    featured && "sm:col-span-2",
  ]}
>
  <div class="flex gap-0.5 text-star" aria-label={`${review.rating} de 5 estrellas`}>
    {Array.from({ length: review.rating }).map(() => <Icon name="star" class="h-4 w-4" />)}
  </div>

  <blockquote
    class:list={[
      "mt-4 flex-1 leading-relaxed text-ink/75",
      featured ? "font-display text-lg leading-snug text-ink sm:text-xl" : "text-sm",
    ]}
  >
    &ldquo;{review.quote}&rdquo;
  </blockquote>

  <figcaption class="mt-5 flex items-center gap-3 border-t border-pool-100 pt-4">
    <span
      class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-pool-700 text-xs font-semibold text-white"
      aria-hidden="true"
    >
      {review.initials}
    </span>
    <span>
      <span class="block text-sm font-semibold text-ink">{review.name}</span>
      <time datetime={review.isoDate} class="block text-xs text-ink/50">
        {review.date} · Google
      </time>
    </span>
  </figcaption>
</figure>
