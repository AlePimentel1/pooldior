---
interface Props {
  name: "asesoramiento" | "fabricacion" | "colocacion" | "mantenimiento" | "servicio" | "star" | "phone" | "pin" | "clock";
  class?: string;
}

const { name, class: className = "h-6 w-6" } = Astro.props;

const cogTicks = Array.from({ length: 8 }, (_, i) => {
  const angle = (i * Math.PI) / 4;
  const inner = 7.2;
  const outer = 9.4;
  return {
    x1: 12 + inner * Math.cos(angle),
    y1: 12 + inner * Math.sin(angle),
    x2: 12 + outer * Math.cos(angle),
    y2: 12 + outer * Math.sin(angle),
  };
});
---

{
  name === "asesoramiento" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
      <rect x="3" y="4.5" width="18" height="12" rx="4" stroke-linejoin="round" />
      <path d="M8.5 16.5L6 20l4.2-2.9" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="9" cy="10.5" r="0.9" fill="currentColor" stroke="none" />
      <circle cx="12" cy="10.5" r="0.9" fill="currentColor" stroke="none" />
      <circle cx="15" cy="10.5" r="0.9" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  name === "fabricacion" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
      <circle cx="12" cy="12" r="4.2" />
      {cogTicks.map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke-linecap="round" />
      ))}
    </svg>
  )
}

{
  name === "colocacion" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
      <path d="M12 3v10" stroke-linecap="round" />
      <path d="M8 9.5L12 13.5L16 9.5" stroke-linecap="round" stroke-linejoin="round" />
      <rect x="4" y="15.5" width="16" height="5" rx="1.2" />
    </svg>
  )
}

{
  name === "mantenimiento" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
      <path d="M12 3.5c2.8 3.5 6 8 6 11.2a6 6 0 01-12 0c0-3.2 3.2-7.7 6-11.2z" stroke-linejoin="round" />
    </svg>
  )
}

{
  name === "servicio" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
      <path d="M4.5 13a7.5 7.5 0 0115 0" stroke-linecap="round" />
      <rect x="3" y="13" width="4" height="6" rx="1.8" />
      <rect x="17" y="13" width="4" height="6" rx="1.8" />
    </svg>
  )
}

{
  name === "star" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class={className}>
      <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.5 1.3 6.6L12 17.4l-5.9 3.1 1.3-6.6-4.9-4.5 6.6-.8z" />
    </svg>
  )
}

{
  name === "phone" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
      <path d="M5 4.5h3.2l1.3 4.3-2 1.6a12 12 0 006.1 6.1l1.6-2 4.3 1.3V19a1.5 1.5 0 01-1.6 1.5A15.5 15.5 0 013.5 6.1 1.5 1.5 0 015 4.5z" stroke-linejoin="round" stroke-linecap="round" />
    </svg>
  )
}

{
  name === "pin" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
      <path d="M12 21s7-6.6 7-11.5a7 7 0 10-14 0C5 14.4 12 21 12 21z" stroke-linejoin="round" />
      <circle cx="12" cy="9.5" r="2.3" />
    </svg>
  )
}

{
  name === "clock" && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
