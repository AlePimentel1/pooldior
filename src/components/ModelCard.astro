---
import PoolPlan from "./PoolPlan.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import type { PoolModel } from "../data/site";
import { num, surfaceArea, waModelMessage } from "../data/site";

interface Props {
  model: PoolModel;
}

const { model } = Astro.props;

const shapeLabel = model.shape === "ovalada" ? "Ovalada" : "Rectangular";
const dims = `${num(model.length)} × ${num(model.width)}`;
---

<article
  class="flex flex-col gap-3 rounded-card border border-pool-200 bg-white p-4 transition-colors hover:border-pool-500"
>
  <PoolPlan model={model} class="block h-auto w-full" />
  <hr class="border-pool-100" />

  <div class="mt-auto flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-medium text-pool-700">{shapeLabel}</p>
      <p class="tnum mt-0.5 font-display text-lg text-ink">{dims}</p>
      <p class="tnum mt-0.5 text-xs text-ink/55">Profundidad {num(model.depth)} m</p>
    </div>
    <div class="text-right">
      <p class="tnum font-semibold text-pool-700">{num(surfaceArea(model))} m²</p>
      <p class="mt-0.5 text-xs text-ink/55">Espejo de agua</p>
    </div>
  </div>

  <WhatsAppButton message={waModelMessage(model)} label="Consultar este modelo" variant="inline" />
</article>
