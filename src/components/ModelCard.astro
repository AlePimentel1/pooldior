---
interface Measure {
  label: string;
}

interface Props {
  id?: string;
  name: string;
  gradient: string;
  measures: Measure[];
  colors: { label: string; hex: string }[];
  reverse?: boolean;
}

const { id, name, gradient, measures, colors, reverse = false } = Astro.props;
---

<div id={id} class="scroll-mt-28 border-t border-pool-900/10">
  <div
    class:list={[
      "container-page grid gap-10 py-16 md:grid-cols-2 md:items-center",
      reverse && "md:[&>*:first-child]:order-2",
    ]}
  >
    <div class:list={["aspect-[4/3] w-full rounded-2xl bg-gradient-to-br", gradient]} />
    <div>
      <h3 class="font-display text-3xl text-pool-950">{name}</h3>

      <p class="mt-5 text-xs uppercase tracking-[0.1em] text-ink/50">Medidas disponibles</p>
      <ul class="mt-3 space-y-2">
        {
          measures.map((m) => (
            <li class="flex items-center gap-3 text-sm text-ink/80">
              <span class="h-1.5 w-1.5 flex-none rounded-full bg-pool-500" />
              {m.label}
            </li>
          ))
        }
      </ul>

      <p class="mt-6 text-xs uppercase tracking-[0.1em] text-ink/50">Colores</p>
      <div class="mt-3 flex flex-wrap gap-3">
        {
          colors.map((c) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-pool-900/10 bg-white py-1.5 pl-1.5 pr-4 text-xs text-ink/80">
              <span
                class="h-5 w-5 rounded-full border border-pool-900/10"
                style={`background-color:${c.hex}`}
              />
              {c.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>
