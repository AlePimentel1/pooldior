---
import Icon from "./Icon.astro";

interface Props {
  icon: "phone" | "pin" | "clock";
  title: string;
  lines: string[];
  href?: string;
}

const { icon, title, lines, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "flex items-start gap-4 rounded-card border border-pool-200 bg-white p-5 transition-colors",
    href && "hover:border-pool-500",
  ]}
>
  <span class="mt-0.5 flex-none text-pool-500">
    <Icon name={icon} class="h-6 w-6" />
  </span>
  <span class="min-w-0">
    <span class="eyebrow block text-ink/50">{title}</span>
    {lines.map((line) => <span class="tnum mt-1 block text-sm font-medium text-ink">{line}</span>)}
  </span>
</Tag>
