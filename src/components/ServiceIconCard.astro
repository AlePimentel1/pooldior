---
import Icon from "./Icon.astro";

interface Props {
  id?: string;
  icon: "asesoramiento" | "fabricacion" | "colocacion" | "mantenimiento" | "servicio";
  title: string;
  description: string;
}

const { id, icon, title, description } = Astro.props;
---

<div id={id} class="group scroll-mt-28 rounded-2xl border border-pool-900/8 bg-white p-8 text-center shadow-sm shadow-pool-900/5 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-pool-900/10">
  <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-pool-100 text-pool-700 transition-colors group-hover:bg-pool-500 group-hover:text-white">
    <Icon name={icon} class="h-7 w-7" />
  </div>
  <h3 class="mt-5 font-display text-xl text-pool-950">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-ink/65">{description}</p>
</div>
