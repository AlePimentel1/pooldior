---
import Icon from "./Icon.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  id?: string;
  index: number;
  title: string;
  description: string;
  /** PNG del sitio original, recoloreado por máscara. Null = SVG inline. */
  iconSrc?: string | null;
  iconName?: "asesoramiento" | "fabricacion";
  /** Mensaje de WhatsApp para consultar por esta etapa en concreto. */
  message: string;
}

const { id, index, title, description, iconSrc = null, iconName, message } = Astro.props;

const step = String(index + 1).padStart(2, "0");
---

<!--
  Las cinco etapas son una secuencia real (asesoramiento → fabricación →
  colocación → mantenimiento → servicio), así que la numeración informa algo
  cierto en vez de decorar.
-->
<article
  id={id}
  class="scroll-mt-28 border-t border-pool-200 pt-6 md:grid md:grid-cols-[3rem_1fr] md:gap-6"
>
  <div class="flex items-center gap-3 md:flex-col md:items-start md:gap-3">
    <span class="tnum eyebrow text-pool-700">{step}</span>
    <span class="text-pool-500">
      {
        iconSrc ? (
          <span
            class="icon-mask block h-7 w-7"
            style={`-webkit-mask-image:url(${iconSrc});mask-image:url(${iconSrc})`}
            aria-hidden="true"
          />
        ) : (
          <Icon name={iconName!} class="h-7 w-7" />
        )
      }
    </span>
  </div>

  <div class="mt-3 md:mt-0">
    <h3 class="font-display text-lg text-ink">{title}</h3>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink/70">{description}</p>
    <WhatsAppButton message={message} label="Consultar" variant="inline" class="mt-3" />
  </div>
</article>
