---
import { navItems, waLink, waMessages } from "../data/site";

interface Props {
  forceDark?: boolean;
}

const { forceDark = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class:list={[
    "fixed inset-x-0 top-0 z-50 transition-colors duration-200",
    forceDark ? "text-ink" : "text-white",
  ]}
  data-force-dark={String(forceDark)}
>
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="PoolDior, inicio">
      <span class="h-6 w-6 flex-none rounded-full rounded-bl-sm bg-pool-500"></span>
      <span class="font-display text-xl">Pool<span class="text-pool-500">Dior</span></span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "border-b-2 py-1 text-sm transition-colors",
                isActive
                  ? "border-pool-500 font-semibold"
                  : "border-transparent opacity-80 hover:border-pool-500 hover:opacity-100",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <a
      href={waLink(waMessages.cotizacion)}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden min-h-11 items-center rounded-md bg-pool-700 px-5 text-sm font-semibold text-white transition-colors hover:bg-pool-800 md:inline-flex"
    >
      Solicitar cotización
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-10 w-10 items-center justify-center md:hidden"
    >
      <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden flex-col border-t border-pool-200 bg-white px-6 py-4 text-ink md:hidden"
  >
    {
      navItems.map((item) => (
        <a href={item.href} class="flex min-h-11 items-center border-b border-pool-100 py-3.5 text-base last:border-none">
          {item.label}
        </a>
      ))
    }
    <a
      href={waLink(waMessages.general)}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex min-h-11 items-center justify-center rounded-md bg-pool-700 px-6 text-sm font-semibold text-white"
    >
      Escribinos por WhatsApp
    </a>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  const forceDark = header?.dataset.forceDark === "true";

  const applyHeaderStyle = () => {
    if (!header) return;
    // Con el menú móvil abierto el fondo ya es sólido: no lo pisamos.
    if (mobileMenu?.classList.contains("flex")) return;

    const solid = window.scrollY > 40;
    header.classList.toggle("bg-white/95", solid);
    header.classList.toggle("backdrop-blur", solid);
    header.classList.toggle("border-b", solid);
    header.classList.toggle("border-pool-200", solid);
    header.classList.toggle("text-ink", solid || forceDark);
    header.classList.toggle("text-white", !solid && !forceDark);
  };

  applyHeaderStyle();
  window.addEventListener("scroll", applyHeaderStyle, { passive: true });

  menuToggle?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.contains("flex");
    mobileMenu?.classList.toggle("hidden", isOpen);
    mobileMenu?.classList.toggle("flex", !isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    menuToggle.setAttribute("aria-expanded", String(!isOpen));

    if (!isOpen) {
      header?.classList.add("bg-white", "text-ink");
      header?.classList.remove("text-white");
    } else {
      header?.classList.remove("bg-white");
      applyHeaderStyle();
    }
  });
</script>
