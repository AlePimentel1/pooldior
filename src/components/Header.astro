---
interface Props {
  forceDark?: boolean;
}

const { forceDark = false } = Astro.props;

const navItems = [
  { label: "Nosotros", href: "/nosotros" },
  { label: "Servicios", href: "/servicios" },
  { label: "Modelos", href: "/modelos" },
  { label: "Contacto", href: "/contacto" },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class:list={["fixed inset-x-0 top-0 z-50 transition-colors duration-300", forceDark ? "text-ink" : "text-sand-50"]}
  data-solid="false"
  data-force-dark={String(forceDark)}
>
  <div class="container-page flex h-20 items-center justify-between">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-display text-2xl tracking-[0.15em] text-current">POOLDIOR</span>
    </a>

    <nav class="hidden items-center gap-10 md:flex">
      {
        navItems.map((item) => {
          const isActive =
            item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "text-sm uppercase tracking-[0.08em] transition-opacity hover:opacity-70",
                isActive ? "opacity-100 font-semibold" : "opacity-80",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <a
      href="/contacto"
      class="hidden rounded-full bg-pool-500 px-6 py-2.5 text-sm uppercase tracking-[0.08em] text-white shadow-sm shadow-pool-900/20 transition-colors hover:bg-pool-600 md:inline-block"
    >
      Solicitar cotización
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="flex h-10 w-10 items-center justify-center md:hidden"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-pool-800/10 bg-sand-50 px-6 py-6 text-ink md:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="py-3 text-base uppercase tracking-[0.08em] border-b border-pool-900/5 last:border-none"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="/contacto"
      class="mt-4 rounded-full bg-pool-500 px-6 py-3 text-center text-sm uppercase tracking-[0.08em] text-white"
    >
      Solicitar cotización
    </a>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  const applyHeaderStyle = () => {
    if (!header) return;
    const solid = window.scrollY > 40;
    header.dataset.solid = String(solid);
    header.classList.toggle("bg-sand-50/95", solid);
    header.classList.toggle("backdrop-blur", solid);
    header.classList.toggle("shadow-sm", solid);
    header.classList.toggle("text-ink", solid || header.dataset.forceDark === "true");
    header.classList.toggle("text-sand-50", !solid && header.dataset.forceDark !== "true");
  };

  applyHeaderStyle();
  window.addEventListener("scroll", applyHeaderStyle, { passive: true });

  menuToggle?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.contains("flex");
    mobileMenu?.classList.toggle("hidden", isOpen);
    mobileMenu?.classList.toggle("flex", !isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    if (!isOpen) {
      header?.classList.add("bg-sand-50", "text-ink");
      header?.classList.remove("text-sand-50");
    } else {
      header?.classList.remove("bg-sand-50");
      applyHeaderStyle();
    }
  });
</script>
