---
import Layout from "../layouts/Layout.astro";
import ModelCard from "../components/ModelCard.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { modelsByShape, gelCoatColors, models, waMessages } from "../data/site";

const groups = [
  { id: "rectangular", title: "Piscina Rectangular", items: modelsByShape.rectangular },
  { id: "ovalada", title: "Piscina Ovalada", items: modelsByShape.ovalada },
];
---

<Layout title="Modelos" forceDarkHeader>
  <section class="bg-sand-50 pb-14 pt-36 md:pt-40">
    <div class="container-page max-w-2xl">
      <h1 class="font-display text-4xl text-ink md:text-5xl">Nuestros modelos</h1>
      <p class="mt-6 max-w-[68ch] leading-relaxed text-ink/70">
        {models.length} medidas de piscina de fibra de vidrio, en tres colores de gel-coat. Los planos
        están dibujados a la misma escala, así que se comparan entre sí tal como son. Todas las
        medidas corresponden al espejo de agua.
      </p>
    </div>
  </section>

  {
    groups.map((group) => (
      <section id={group.id} class="scroll-mt-24 bg-sand-50 py-14">
        <div class="container-page">
          <div class="flex items-center gap-4">
            <h2 class="font-display text-xl text-ink">{group.title}</h2>
            <span class="h-px flex-1 bg-pool-200" />
            <span class="text-sm text-ink/55">{group.items.length} medidas</span>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {group.items.map((model) => (
              <ModelCard model={model} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="bg-sand-100 py-14">
    <div class="container-page">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div>
          <h2 class="font-display text-xl text-ink">Tres terminaciones de gel-coat</h2>
        </div>
        <ul class="flex flex-wrap gap-3">
          {
            gelCoatColors.map((color) => (
              <li class="flex items-center gap-3">
                <span
                  class="h-8 w-8 flex-none rounded-full ring-1 ring-inset ring-ink/10"
                  style={`background-color:${color.hex}`}
                  aria-hidden="true"
                />
                <span class="text-sm font-medium text-ink">{color.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="mt-8 flex max-w-[68ch] flex-wrap items-center gap-3 text-sm text-ink/55">
        <span>Todos los planos a escala 1:100</span>
        <span class="h-px flex-1 bg-pool-200"></span>
        <span>Superficie calculada sobre las medidas de catálogo</span>
      </p>
    </div>
  </section>

  <section class="bg-navy-900 py-16 text-white">
    <div
      class="container-page flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h2 class="max-w-xl font-display text-2xl md:text-3xl">
          ¿No sabés cuál te entra en el fondo?
        </h2>
        <p class="mt-2 text-sm text-white/70">
          Vamos al terreno, lo evaluamos y te decimos qué modelo conviene.
        </p>
      </div>
      <WhatsAppButton message={waMessages.visita} label="Consultar por WhatsApp" />
    </div>
  </section>
</Layout>
