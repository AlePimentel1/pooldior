---
import Layout from "../layouts/Layout.astro";
import ModelCard from "../components/ModelCard.astro";

const colors = [
  { label: "Celeste", hex: "#7fd1e0" },
  { label: "Arena", hex: "#d9c6a0" },
  { label: "Blanca", hex: "#ffffff" },
];

const models = [
  {
    id: "rectangular",
    name: "Piscina Rectangular",
    gradient: "from-pool-400 to-pool-700",
    measures: [
      { label: "6 x 3 m — espejo de agua x 1,4 m profundidad" },
      { label: "8 x 3 m — espejo de agua x 1,5 m profundidad" },
      { label: "7 x 3 m — espejo de agua x 1,4 m profundidad" },
      { label: "8 x 4 m — espejo de agua x 1,5 m profundidad" },
    ],
  },
  {
    id: "ovalada",
    name: "Piscina Ovalada",
    gradient: "from-pool-500 to-pool-900",
    measures: [
      { label: "4,6 x 2,2 m — espejo de agua x 1,4 m profundidad" },
      { label: "5,5 x 2,7 m — espejo de agua x 1,4 m profundidad" },
      { label: "6,7 x 3,1 m — espejo de agua x 1,4 m profundidad" },
    ],
  },
  {
    id: "rinon",
    name: "Piscina Riñón",
    gradient: "from-pool-600 to-pool-950",
    measures: [
      { label: "6 x 3,5 m — espejo de agua x 1,4 m profundidad" },
      { label: "7 x 4 m — espejo de agua x 1,5 m profundidad" },
    ],
  },
  {
    id: "infinita",
    name: "Piscina Desbordante",
    gradient: "from-brass-500 to-pool-800",
    measures: [
      { label: "8 x 3,5 m — espejo de agua x 1,5 m profundidad" },
      { label: "9 x 4 m — espejo de agua x 1,6 m profundidad" },
    ],
  },
];
---

<Layout title="Modelos" forceDarkHeader>
  <section class="bg-sand-50 pb-16 pt-40">
    <div class="container-page max-w-2xl">
      <p class="text-xs uppercase tracking-[0.2em] text-pool-600">Catálogo</p>
      <h1 class="mt-4 font-display text-5xl text-pool-950">Nuestros modelos</h1>
      <p class="mt-6 text-base leading-relaxed text-ink/70">
        Piscinas de fibra de vidrio en distintas formas y medidas, con tres opciones de color
        para integrarse a cualquier espacio.
      </p>
    </div>
  </section>

  {
    models.map((model, index) => (
      <ModelCard
        id={model.id}
        name={model.name}
        gradient={model.gradient}
        measures={model.measures}
        colors={colors}
        reverse={index % 2 === 1}
      />
    ))
  }

  <section class="bg-pool-950 py-20 text-white">
    <div class="container-page flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <h2 class="max-w-lg font-display text-3xl">
        ¿No encontrás la medida que buscás? Diseñamos a medida sobre estos modelos.
      </h2>
      <a
        href="/contacto"
        class="rounded-full bg-brass-500 px-8 py-3.5 text-sm uppercase tracking-[0.08em] text-pool-950 transition-colors hover:bg-brass-400"
      >
        Consultar
      </a>
    </div>
  </section>
</Layout>
