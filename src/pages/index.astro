---
import Layout from "../layouts/Layout.astro";
import ServiceIconCard from "../components/ServiceIconCard.astro";
import ModelCard from "../components/ModelCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Icon from "../components/Icon.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import {
  company,
  contact,
  warranty,
  services,
  models,
  reviews,
  reviewScore,
  equipment,
  waMessages,
  waServiceMessage,
} from "../data/site";

const iconNames = ["asesoramiento", "fabricacion"] as const;

/** Solo cifras verificables. Nada de "+500 piscinas" sin fuente. */
const stats = [
  { value: String(company.since), label: "Fabricando piscinas en Uruguay" },
  { value: String(models.length), label: "Modelos de catálogo en fibra de vidrio" },
  { value: String(warranty.structureYears), label: "Años de garantía en la estructura" },
  { value: reviewScore.averageLabel, label: `Promedio en ${reviewScore.count} reseñas de Google` },
];

const homeReviews = reviews.slice(0, 3);
---

<Layout title={company.name}>
  <!-- ══════════ Hero ══════════
       Video real del sitio en producción sobre fondo navy. Sin gradiente
       decorativo, sin blobs desenfocados, sin patrón de hexágonos. -->
  <section class="relative isolate overflow-hidden bg-navy-900">
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      poster="/img/hero-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-navy-900/90 via-navy-900/80 to-navy-900/95"
    >
    </div>

    <div class="container-page relative pb-32 pt-36 md:pb-40 md:pt-44">
      <h1 class="max-w-[15ch] font-display text-4xl leading-[1.05] text-white sm:text-6xl md:text-7xl">
        Disfrutá de tu piscina <span class="text-pool-400">todo el año</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-white/85 md:text-lg">
        La única empresa integral en fabricación de piscinas del país. Fabricamos, colocamos,
        mantenemos y damos servicio técnico nosotros mismos — de punta a punta, sin tercerizar.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <WhatsAppButton message={waMessages.cotizacion} label="Solicitar cotización" />
        <a
          href="/modelos"
          class="rounded-md border border-white/45 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
        >
          Ver los {models.length} modelos
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-white/80">
        <li>
          <b class="font-semibold text-white">{warranty.structureYears} años</b> de garantía en estructura
        </li>
        <li><b class="font-semibold text-white">{reviewScore.averageLabel}</b> en reseñas de Google</li>
        <li>Cobertura en <b class="font-semibold text-white">{company.coverage.toLowerCase()}</b></li>
      </ul>
    </div>

    <svg
      class="relative z-10 block w-full text-sand-50"
      viewBox="0 0 1440 80"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M0 40c120-30 240-30 360 0s240 30 360 0 240-30 360 0 240 30 360 0v40H0z" fill="currentColor"></path>
    </svg>
  </section>

  <!-- ══════════ Cifras ══════════
       `relative -mt-px` tapa el hairline que deja la ola. El <svg> divisor usa
       preserveAspectRatio="none", así que su alto es ancho÷18 y cae en fracción
       de píxel: el rasterizador por GPU antialiasea esa última fila y asoma el
       navy de la hero por detrás. Subiendo esta sección 1px, su fondo opaco la
       cubre. Necesita `relative` porque la hero es `relative isolate`: entre dos
       elementos posicionados con z-index auto gana el último del DOM, y estático
       no alcanzaría para pintar por encima. -->
  <section class="relative -mt-px border-b border-pool-200 bg-sand-50">
    <div class="container-page grid grid-cols-2 gap-x-8 gap-y-10 pb-14 md:grid-cols-4">
      {
        stats.map((stat) => (
          <div>
            <p class="tnum font-display text-3xl text-pool-700 md:text-4xl">{stat.value}</p>
            <p class="mt-1.5 max-w-[22ch] text-sm leading-snug text-ink/60">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ══════════ Nosotros ══════════ -->
  <section class="bg-sand-50 py-20 md:py-24">
    <div class="container-page grid gap-10 md:grid-cols-2 md:items-center md:gap-14">
      <div class="relative">
        <img
          src="/img/local-pooldior.jpg"
          alt="Local de PoolDior con dos piscinas de fibra de vidrio exhibidas en la entrada"
          width="1200"
          height="675"
          loading="lazy"
          class="w-full rounded-card border border-pool-200"
        />
      </div>
      <div>
        <h2 class="font-display text-3xl text-ink md:text-4xl">
          De la fábrica al primer chapuzón, una sola empresa
        </h2>
        <p class="mt-5 leading-relaxed text-ink/70">{company.about}</p>
        <ul class="mt-7 flex flex-wrap gap-2">
          {
            equipment.map((item) => (
              <li class="rounded-md border border-pool-200 bg-pool-50 px-3 py-1.5 text-sm text-pool-700">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════ Servicios ══════════ -->
  <section class="bg-sand-100 py-20 md:py-24">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl text-ink md:text-4xl">
          Cinco etapas, un solo responsable
        </h2>
        <p class="mt-5 leading-relaxed text-ink/70">
          Del primer relevamiento del terreno al servicio técnico {warranty.structureYears} años
          después, cada etapa la hace nuestro equipo. Nunca vas a tener que perseguir a un tercero.
        </p>
      </div>

      <div class="mt-12 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, i) => (
            <ServiceIconCard
              index={i}
              title={service.title}
              description={service.description}
              iconSrc={service.iconSrc}
              iconName={service.iconSrc === null ? iconNames[i] : undefined}
              message={waServiceMessage(service)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════ Modelos ══════════ -->
  <section class="bg-sand-50 py-20 md:py-24">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl text-ink md:text-4xl">
            Siete medidas, dibujadas a escala
          </h2>
          <p class="mt-5 leading-relaxed text-ink/70">
            Todos los planos están a la misma escala, así que las piscinas se comparan entre sí tal
            como son. Las medidas corresponden al espejo de agua, en metros.
          </p>
        </div>
        <a
          href="/modelos"
          class="text-sm font-semibold text-pool-700 underline underline-offset-4 transition-colors hover:text-pool-500"
        >
          Ver el catálogo completo
        </a>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {models.slice(0, 4).map((model) => <ModelCard model={model} />)}
      </div>
    </div>
  </section>

  <!-- ══════════ Garantía ══════════ -->
  <section class="bg-navy-900 py-20 text-white md:py-24">
    <div class="container-page grid gap-10 md:grid-cols-2 md:items-center md:gap-14">
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-card border border-white/12 bg-navy-800 p-6">
          <p class="tnum font-display text-5xl text-pool-400">{warranty.structureYears}</p>
          <p class="mt-2.5 text-sm leading-snug text-white/60">Años de garantía en la estructura</p>
        </div>
        <div class="rounded-card border border-white/12 bg-navy-800 p-6">
          <p class="tnum font-display text-5xl text-pool-400">{warranty.equipmentYears}</p>
          <p class="mt-2.5 text-sm leading-snug text-white/60">Años de garantía en el equipamiento</p>
        </div>
      </div>
      <div>
        <h2 class="font-display text-3xl md:text-4xl">Una piscina se hace una sola vez</h2>
        <p class="mt-5 leading-relaxed text-white/75">
          Por eso respaldamos la estructura de fibra de vidrio con {warranty.structureYears} años de
          garantía y el equipamiento con {warranty.equipmentYears} — y el servicio técnico que la
          cubre es el nuestro, no el de un tercero.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <WhatsAppButton message={waMessages.cotizacion} label="Pedir cotización" />
          <a
            href={contact.phoneHref}
            class="tnum rounded-md border border-white/45 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
          >
            {contact.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ Reseñas ══════════ -->
  <section class="bg-sand-100 py-20 md:py-24">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl text-ink md:text-4xl">
            Lo que dicen quienes ya se están bañando
          </h2>
        </div>
        <div class="flex items-center gap-3">
          <span class="tnum font-display text-3xl text-ink">{reviewScore.averageLabel}</span>
          <span>
            <span class="flex gap-0.5 text-star" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-4 w-4" />)}
            </span>
            <span class="mt-0.5 block text-xs text-ink/55">
              {reviewScore.count} reseñas verificadas de Google
            </span>
          </span>
        </div>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {homeReviews.map((review, i) => <TestimonialCard review={review} featured={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- ══════════ CTA final ══════════ -->
  <section class="border-t border-pool-200 bg-sand-50">
    <div
      class="container-page flex flex-col items-start gap-6 py-16 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h2 class="max-w-xl font-display text-2xl text-ink md:text-3xl">
          ¿Listo para tener tu piscina el año que viene por estas fechas?
        </h2>
        <p class="tnum mt-2 text-sm text-ink/60">
          Escribinos al {contact.phone} o pedí la visita al terreno.
        </p>
      </div>
      <WhatsAppButton message={waMessages.visita} label="Pedir la visita al terreno" />
    </div>
  </section>
</Layout>
