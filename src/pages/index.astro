---
import Layout from "../layouts/Layout.astro";
import ServiceIconCard from "../components/ServiceIconCard.astro";
import ModelCard from "../components/ModelCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";

const services = [
  {
    icon: "asesoramiento" as const,
    title: "Asesoramiento",
    description: "Te ayudamos a elegir el modelo, la ubicación y el equipamiento ideal para tu espacio.",
  },
  {
    icon: "fabricacion" as const,
    title: "Fabricación",
    description: "Piscinas de fibra de vidrio fabricadas con tecnología y mano de obra calificada.",
  },
  {
    icon: "colocacion" as const,
    title: "Colocación",
    description: "Instalación completa a cargo de nuestro equipo técnico, en tiempo y forma.",
  },
  {
    icon: "mantenimiento" as const,
    title: "Mantenimiento",
    description: "Planes de mantenimiento periódico para que disfrutes tu piscina todo el año.",
  },
  {
    icon: "servicio" as const,
    title: "Servicio",
    description: "Servicio técnico y equipamiento con garantía, siempre que lo necesites.",
  },
];

const stats = [
  { value: "2014", label: "en el mercado uruguayo" },
  { value: "15", label: "años de garantía en estructura" },
  { value: "3", label: "años de garantía en equipamiento" },
  { value: "+500", label: "piscinas instaladas" },
];

const testimonials = [
  {
    name: "Sierra M.",
    role: "Montevideo",
    quote: "Instalaron nuestra piscina en tiempo récord y el terminado quedó impecable. Súper recomendable.",
    initials: "SM",
    avatarColor: "#16888f",
  },
  {
    name: "Ramiro S.",
    role: "Canelones",
    quote: "El asesoramiento previo fue clave para elegir el modelo correcto. Muy buena atención en todo el proceso.",
    initials: "RS",
    avatarColor: "#d97706",
  },
  {
    name: "Micaela D.",
    role: "Maldonado",
    quote: "Contratamos el mantenimiento anual y no tenemos que preocuparnos por nada. Excelente servicio técnico.",
    initials: "MD",
    avatarColor: "#0b4247",
  },
];
---

<Layout title="Pooldior">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-pool-500 via-pool-700 to-pool-950">
    <div class="pattern-hex absolute inset-0 opacity-70"></div>
    <div class="absolute -left-24 top-24 h-72 w-72 rounded-full bg-pool-400/30 blur-3xl"></div>
    <div class="absolute -right-16 top-1/3 h-80 w-80 rounded-full bg-brass-400/20 blur-3xl"></div>

    <div class="container-page relative z-10 grid gap-12 pb-28 pt-40 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-pool-100">Disfrutá de tu piscina</p>
        <h1 class="mt-6 max-w-2xl font-display text-5xl leading-[1.05] text-white sm:text-6xl md:text-7xl">
          Todo el año
        </h1>
        <p class="mt-6 max-w-lg text-base leading-relaxed text-pool-50/85">
          Fabricamos, colocamos y mantenemos piscinas de fibra de vidrio en todo Uruguay desde
          2014, con la calidad y garantía que tu proyecto merece.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/contacto"
            class="rounded-full bg-white px-8 py-3.5 text-sm uppercase tracking-[0.08em] text-pool-900 transition-colors hover:bg-pool-50"
          >
            Solicitar cotización
          </a>
          <a
            href="/modelos"
            class="rounded-full border border-white/40 px-8 py-3.5 text-sm uppercase tracking-[0.08em] text-white transition-colors hover:border-white"
          >
            Ver modelos
          </a>
        </div>
      </div>

      <div class="glass-card rounded-2xl p-8 text-white">
        <h2 class="font-display text-2xl">Solicitá tu cotización</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          Contanos qué modelo te interesa y te respondemos con una propuesta a medida en menos de
          24 horas.
        </p>
        <a
          href="/contacto"
          class="mt-6 inline-flex rounded-full bg-brass-500 px-6 py-3 text-sm uppercase tracking-[0.08em] text-pool-950 transition-colors hover:bg-brass-400"
        >
          Contactarme
        </a>
      </div>
    </div>

    <svg class="relative z-10 block w-full text-sand-50" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path d="M0 40c120-30 240-30 360 0s240 30 360 0 240-30 360 0 240 30 360 0v40H0z" fill="currentColor" />
    </svg>
  </section>

  <!-- Stats strip -->
  <section class="bg-sand-50">
    <div class="container-page grid grid-cols-2 gap-8 pb-16 md:grid-cols-4">
      {
        stats.map((stat) => (
          <div>
            <p class="font-display text-3xl text-pool-700 md:text-4xl">{stat.value}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.08em] text-ink/50">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Servicios -->
  <section class="relative bg-sand-100 py-24">
    <div class="pattern-hex absolute inset-0 opacity-40"></div>
    <div class="container-page relative">
      <div class="mx-auto max-w-xl text-center">
        <p class="text-xs uppercase tracking-[0.2em] text-pool-600">Nuestros servicios</p>
        <h2 class="mt-4 font-display text-4xl text-pool-950">Te acompañamos en todo el proceso</h2>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {services.map((service) => <ServiceIconCard {...service} />)}
      </div>
    </div>
  </section>

  <!-- Modelos preview -->
  <section class="bg-sand-50 pt-4">
    <div class="container-page flex flex-wrap items-end justify-between gap-6 pt-16">
      <div class="max-w-xl">
        <p class="text-xs uppercase tracking-[0.2em] text-pool-600">Catálogo</p>
        <h2 class="mt-4 font-display text-4xl text-pool-950">Nuestros modelos</h2>
      </div>
      <a
        href="/modelos"
        class="text-xs uppercase tracking-[0.1em] text-pool-700 transition-colors hover:text-brass-600"
      >
        Ver todos los modelos
      </a>
    </div>

    <ModelCard
      name="Piscina Rectangular"
      gradient="from-pool-400 to-pool-700"
      measures={[
        { label: "6 x 3 m — espejo de agua x 1,4 m profundidad" },
        { label: "8 x 3 m — espejo de agua x 1,5 m profundidad" },
        { label: "7 x 3 m — espejo de agua x 1,4 m profundidad" },
      ]}
      colors={[
        { label: "Celeste", hex: "#7fd1e0" },
        { label: "Arena", hex: "#d9c6a0" },
        { label: "Blanca", hex: "#ffffff" },
      ]}
    />

    <ModelCard
      name="Piscina Ovalada"
      gradient="from-pool-500 to-pool-900"
      measures={[
        { label: "4,6 x 2,2 m — espejo de agua x 1,4 m profundidad" },
        { label: "5,5 x 2,7 m — espejo de agua x 1,4 m profundidad" },
        { label: "6,7 x 3,1 m — espejo de agua x 1,4 m profundidad" },
      ]}
      colors={[
        { label: "Celeste", hex: "#7fd1e0" },
        { label: "Arena", hex: "#d9c6a0" },
        { label: "Blanca", hex: "#ffffff" },
      ]}
      reverse
    />
  </section>

  <!-- Testimonios -->
  <section class="bg-pool-950 py-24">
    <div class="container-page">
      <div class="mx-auto max-w-xl text-center">
        <p class="text-xs uppercase tracking-[0.2em] text-pool-200">Testimonios</p>
        <h2 class="mt-4 font-display text-4xl text-white">Lo que dicen nuestros clientes</h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {testimonials.map((testimonial) => <TestimonialCard {...testimonial} />)}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="bg-brass-500">
    <div class="container-page flex flex-col items-start gap-6 py-20 md:flex-row md:items-center md:justify-between">
      <h2 class="max-w-lg font-display text-3xl text-pool-950 md:text-4xl">
        ¿Listo para tener tu piscina el año que viene por estas fechas?
      </h2>
      <a
        href="/contacto"
        class="rounded-full bg-pool-950 px-8 py-3.5 text-sm uppercase tracking-[0.08em] text-white transition-colors hover:bg-pool-900"
      >
        Hablemos
      </a>
    </div>
  </section>
</Layout>
