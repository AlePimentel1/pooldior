---
import Layout from "../layouts/Layout.astro";
import InfoCard from "../components/InfoCard.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { contact, company, waMessages } from "../data/site";

// Cada tema abre WhatsApp con su mensaje ya escrito: la persona solo aprieta
// enviar, y del otro lado se sabe de entrada sobre qué es la consulta.
const topics = [
  {
    title: "Quiero cotizar una piscina",
    description: "Te pasamos precios de los modelos y coordinamos la visita al terreno.",
    message: waMessages.cotizacion,
  },
  {
    title: "Mantenimiento o servicio técnico",
    description: "Para una piscina que ya está instalada, sea nuestra o no.",
    message: waMessages.servicios,
  },
  {
    title: "No sé qué modelo me entra",
    description: "Vamos al terreno, lo evaluamos y te decimos cuál conviene.",
    message: waMessages.visita,
  },
];

const infoCards = [
  {
    icon: "phone" as const,
    title: "Teléfono",
    lines: [contact.phone],
    href: contact.phoneHref,
  },
  {
    icon: "clock" as const,
    title: "Horario",
    lines: contact.hours.map((h) => `${h.days} ${h.time}`),
  },
  {
    icon: "pin" as const,
    title: "Cobertura",
    lines: [company.coverage],
  },
];
---

<Layout title="Contacto" forceDarkHeader>
  <section class="bg-sand-50 pb-14 pt-36 md:pt-40">
    <div class="container-page max-w-2xl">
      <h1 class="font-display text-4xl text-ink md:text-5xl">Contanos dónde va la piscina</h1>
      <p class="mt-6 max-w-[68ch] leading-relaxed text-ink/70">
        Atendemos por WhatsApp. Elegí sobre qué querés consultar y se abre el chat con el mensaje ya
        escrito — solo agregás tu localidad y lo mandás.
      </p>
    </div>

    <div class="container-page mt-10 grid gap-4 sm:grid-cols-3">
      {infoCards.map((card) => <InfoCard {...card} />)}
    </div>
  </section>

  <section class="container-page pb-20">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-14">
      <div class="rounded-card bg-navy-900 p-8 text-white sm:p-9">
        <h2 class="font-display text-xl">Escribinos al {contact.whatsapp}</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          Es la vía más rápida y la que más usamos. Te respondemos dentro del horario de atención.
        </p>
        <WhatsAppButton
          message={waMessages.general}
          label="Abrir WhatsApp"
          class="mt-6 w-full sm:w-auto"
        />

        <hr class="my-7 border-white/15" />

        <h3 class="text-sm font-semibold text-white/60">También podés llamarnos</h3>
        <a
          href={contact.phoneHref}
          class="tnum mt-2 block font-display text-2xl text-pool-400 transition-colors hover:text-pool-300"
        >
          {contact.phone}
        </a>
        <ul class="mt-4 space-y-1 text-sm text-white/60">
          {contact.hours.map((h) => <li class="tnum">{h.days} {h.time}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-display text-2xl text-ink">¿Sobre qué querés consultar?</h2>
        <ul class="mt-6 grid gap-4">
          {
            topics.map((topic) => (
              <li class="rounded-card border border-pool-200 bg-white p-6 transition-colors hover:border-pool-500">
                <h3 class="font-display text-lg text-ink">{topic.title}</h3>
                <p class="mt-2 max-w-[60ch] text-sm leading-relaxed text-ink/70">
                  {topic.description}
                </p>
                <WhatsAppButton
                  message={topic.message}
                  label="Consultar por WhatsApp"
                  variant="inline"
                  class="mt-4"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>
