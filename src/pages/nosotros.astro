---
import Layout from "../layouts/Layout.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { company, warranty, models, reviews, reviewScore, contact, waMessages } from "../data/site";

/**
 * Sin línea de tiempo inventada y sin "+500 piscinas instaladas": no hay
 * ninguna fuente que respalde esas cifras. Lo que va acá es verificable.
 */
const values = [
  {
    title: "Empresa integral",
    description:
      "Fabricamos, colocamos y mantenemos. Un solo equipo te acompaña en todo el proceso, y es el mismo que responde después.",
  },
  {
    title: "Fibra de vidrio",
    description: `${models.length} modelos de catálogo en tres colores de gel-coat, fabricados para durar bajo el clima uruguayo.`,
  },
  {
    title: "Garantía real",
    description: `${warranty.structureYears} años en la estructura y ${warranty.equipmentYears} en el equipamiento, con servicio técnico propio.`,
  },
];

const featuredReviews = reviews.slice(0, 2);
---

<Layout title="Nosotros" forceDarkHeader>
  <section class="bg-sand-50 pb-14 pt-36 md:pt-40">
    <div class="container-page grid gap-10 md:grid-cols-2 md:items-center md:gap-14">
      <div>
        <h1 class="font-display text-4xl text-ink md:text-5xl">
          La única empresa integral de piscinas en Uruguay
        </h1>
        <p class="mt-6 max-w-[68ch] leading-relaxed text-ink/70">{company.about}</p>
      </div>
      <img
        src="/img/local-pooldior.jpg"
        alt="Local de PoolDior con dos piscinas de fibra de vidrio exhibidas en la entrada"
        width="1200"
        height="675"
        loading="lazy"
        class="w-full rounded-card border border-pool-200"
      />
    </div>
  </section>

  <section class="bg-navy-900 py-16 text-white md:py-20">
    <div class="container-page">
      <h2 class="font-display text-2xl md:text-3xl">Por qué elegirnos</h2>
      <div class="mt-8 grid gap-x-10 gap-y-8 md:grid-cols-3">
        {
          values.map((value) => (
            <div class="border-t border-white/15 pt-5">
              <h3 class="font-display text-lg">{value.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-white/70">{value.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-sand-50 py-16 md:py-20">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl text-ink md:text-4xl">
          {reviewScore.count} reseñas de Google, promedio {reviewScore.averageLabel}
        </h2>
        <p class="mt-5 leading-relaxed text-ink/70">
          No las escribimos nosotros. Son las reseñas públicas que dejaron quienes ya tienen su
          piscina instalada.
        </p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {featuredReviews.map((review) => <TestimonialCard review={review} />)}
      </div>
    </div>
  </section>

  <section class="border-t border-pool-200 bg-sand-100">
    <div
      class="container-page flex flex-col items-start gap-6 py-16 md:flex-row md:items-center md:justify-between"
    >
      <h2 class="max-w-xl font-display text-2xl text-ink md:text-3xl">
        Conversemos sobre la piscina de tu próximo proyecto.
      </h2>
      <div class="flex flex-wrap gap-3">
        <WhatsAppButton message={waMessages.general} label="Escribirnos por WhatsApp" />
        <a
          href={contact.phoneHref}
          class="tnum inline-flex min-h-11 items-center rounded-md border border-pool-300 px-7 py-3.5 text-sm font-semibold text-pool-700 transition-colors hover:border-pool-500 hover:bg-white"
        >
          {contact.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
